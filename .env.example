# Host port the app is published on (http://<server-ip>:8085)
RACKPLANNER_PORT=8085

# User/group that owns ./data on the host (run `id` to see yours).
PUID=1000
PGID=1000

# Optional HTTP basic auth: set both to enable.
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
